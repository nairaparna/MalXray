def _font(size, bold=False):
    fam = (
        "Segoe UI"
        if sys.platform == "win32"
        else "Helvetica Neue" if sys.platform == "darwin" else "DejaVu Sans"
    )
    return (fam, size, "bold") if bold else (fam, size)


def _round_rect(c, x1, y1, x2, y2, r, **kw):
    pts = [
        x1 + r, y1, x2 - r, y1, x2, y1, x2, y1 + r,
        x2, y2 - r, x2, y2, x2 - r, y2, x1 + r, y2,
        x1, y2, x1, y2 - r, x1, y1 + r, x1, y1,
    ]
    return c.create_polygon(pts, smooth=True, **kw)


def _human_size(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def _open_path(path):
    try:
        if os.name == "nt":
            os.startfile(path)  # noqa: S606
        elif sys.platform == "darwin":
            subprocess.Popen(["open", path])
        else:
            subprocess.Popen(["xdg-open", path])
    except Exception as e:
        messagebox.showerror("Open", str(e))


class FlatButton(tk.Label):
    """Flat, hover-aware button (looks identical on Windows/macOS/Linux)."""

    STYLES = {
        "primary": (COLORS["accent2"], "#9279ff", "white"),
        "ghost": (COLORS["surface2"], COLORS["border"], COLORS["text"]),
    }

    def __init__(self, parent, text, command, kind="primary", **kw):
        self.kind = kind
        self.command = command
        self.enabled = True
        bg, _, fg = self.STYLES[kind]
        super().__init__(
            parent, text=text, bg=bg, fg=fg, cursor="hand2",
            font=_font(11 if kind == "primary" else 10, kind == "primary"),
            padx=18, pady=10 if kind == "primary" else 7, **kw,
        )
        self.bind("<Enter>", lambda e: self._paint(True))
        self.bind("<Leave>", lambda e: self._paint(False))
        self.bind("<Button-1>", self._click)

    def _paint(self, hover):
        bg, hov, fg = self.STYLES[self.kind]
        if not self.enabled:
            self.configure(bg=COLORS["border"], fg=COLORS["muted"], cursor="arrow")
        else:
            self.configure(bg=hov if hover else bg, fg=fg, cursor="hand2")

    def _click(self, _):
        if self.enabled and self.command:
            self.command()

    def set_enabled(self, on):
        self.enabled = on
        self._paint(False)


class Toggle(tk.Canvas):
    """Pill-shaped on/off switch bound to a BooleanVar."""

    def __init__(self, parent, variable, bg, command=None):
        super().__init__(parent, width=42, height=24, bg=bg,
                         highlightthickness=0, cursor="hand2")
        self.var = variable
        self.command = command
        self.bind("<Button-1>", self._flip)
        self.var.trace_add("write", lambda *_: self._draw())
        self._draw()

    def _flip(self, _):
        self.var.set(not self.var.get())
        if self.command:
            self.command()

    def _draw(self):
        self.delete("all")
        on = self.var.get()
        _round_rect(self, 1, 2, 41, 22, 10,
                    fill=COLORS["accent"] if on else COLORS["border"], outline="")
        x = 30 if on else 12
        self.create_oval(x - 8, 4, x + 8, 20, fill="white", outline="")


class StepTracker(tk.Canvas):
    STEPS = [
        ("Inspect", "hashes · type"),
        ("Behave", "sandbox run"),
        ("Fuse", "merge features"),
        ("Classify", "XGBoost model"),
        ("Cross-check", "VirusTotal"),
        ("Verdict", "risk + report"),
    ]
    # backend "Step N" -> tracker index
    MAP = {1: 0, 2: 1, 3: 2, 4: 3, 5: 4, 6: 5, 7: 5}

    def __init__(self, parent, bg):
        super().__init__(parent, height=96, bg=bg, highlightthickness=0)
        self.current = -1
        self.skipped = set()
        self.all_done = False
        self.failed = False
        self.pulse = 0
        self.bind("<Configure>", lambda e: self.draw())

    def reset(self):
        self.current, self.skipped = -1, set()
        self.all_done = self.failed = False
        self.draw()

    def set_step(self, backend_step, skipped=False):
        idx = self.MAP.get(backend_step)
        if idx is None:
            return
        self.current = idx
        if skipped:
            self.skipped.add(idx)
        else:
            self.skipped.discard(idx)
        self.draw()

    def finish(self, ok=True):
        self.all_done, self.failed = ok, not ok
        self.draw()

    def tick(self):
        self.pulse = (self.pulse + 1) % 2
        if 0 <= self.current and not self.all_done and not self.failed:
            self.draw()

    def draw(self):
        self.delete("all")
        w = max(self.winfo_width(), 400)
        n = len(self.STEPS)
        margin = 64
        xs = [margin + i * (w - 2 * margin) / (n - 1) for i in range(n)]
        y = 26
        for i in range(n - 1):
            done = self.all_done or i < self.current
            self.create_line(xs[i] + 16, y, xs[i + 1] - 16, y, width=3,
                             fill=COLORS["accent"] if done else COLORS["border"])
        for i, (name, sub) in enumerate(self.STEPS):
            x = xs[i]
            done = self.all_done or i < self.current
            active = i == self.current and not self.all_done
            if self.failed and active:
                fill, outline, glyph, gcol = COLORS["danger"], COLORS["danger"], "!", "white"
            elif i in self.skipped and (done or active):
                fill, outline, glyph, gcol = COLORS["surface2"], COLORS["border"], "–", COLORS["muted"]
            elif done:
                fill, outline, glyph, gcol = COLORS["success"], COLORS["success"], "✓", COLORS["bg"]
            elif active:
                fill = COLORS["accent2"]
                outline = COLORS["accent"] if self.pulse else COLORS["accent2"]
                glyph, gcol = str(i + 1), "white"
            else:
                fill, outline, glyph, gcol = COLORS["surface"], COLORS["border"], str(i + 1), COLORS["muted"]
            self.create_oval(x - 15, y - 15, x + 15, y + 15, fill=fill, outline=outline, width=2)
            self.create_text(x, y, text=glyph, fill=gcol, font=_font(11, True))
            lit = done or active
            self.create_text(x, 58, text=name, font=_font(10, True),
                             fill=COLORS["text"] if lit else COLORS["muted"])
            self.create_text(x, 76, text=sub, font=_font(8), fill=COLORS["muted"])


class Gauge(tk.Canvas):
    """Half-circle malware-likelihood meter."""

    def __init__(self, parent, bg):
        super().__init__(parent, width=240, height=150, bg=bg, highlightthickness=0)
        self.value = 0.0
        self._job = None
        self.draw(0.0, None)

    @staticmethod
    def colour(v):
        return COLORS["success"] if v < 0.35 else COLORS["warning"] if v < 0.65 else COLORS["danger"]

    def draw(self, v, label):
        self.delete("all")
        box = (30, 20, 210, 200)
        self.create_arc(*box, start=180, extent=-180, style="arc", width=16,
                        outline=COLORS["border"])
        if v > 0.003:
            self.create_arc(*box, start=180, extent=-180 * v, style="arc", width=16,
                            outline=self.colour(v))
        self.create_text(120, 90, text=label if label is not None else "–",
                         fill=COLORS["text"], font=_font(26, True))
        self.create_text(120, 122, text="malware likelihood", fill=COLORS["muted"],
                         font=_font(9))
        self.create_text(30, 110, text="0", fill=COLORS["muted"], font=_font(8))
        self.create_text(210, 110, text="100", fill=COLORS["muted"], font=_font(8))

    def animate_to(self, target, available=True):
        if self._job:
            self.after_cancel(self._job)
        if not available:
            self.draw(0.0, "N/A")
            return
        frames = 28

        def step(i=0):
            v = target * (i / frames) ** 0.6
            self.draw(v, f"{v * 100:.0f}%")
            if i < frames:
                self._job = self.after(18, step, i + 1)

        step()



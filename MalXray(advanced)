    def _append(self, text, tag=None):
        self.output.insert("end", text, tag)
        self.output.see("end")

    def _drain_output(self):
        try:
            while True:
                self._buf += self.output_queue.get_nowait()
        except queue.Empty:
            pass
        while "\n" in self._buf:
            line, self._buf = self._buf.split("\n", 1)
            self._handle_line(line)
        self.after(80, self._drain_output)

    STEP_TEXT = {
        1: "Reading the file and computing its fingerprints…",
        2: "Running it in the sandbox…",
        3: "Merging static and runtime features…",
        4: "Asking the XGBoost model…",
        5: "Cross-checking with VirusTotal…",
        6: "Weighing the evidence…",
        7: "Writing the PDF report…",
    }

    def _handle_line(self, line):
        tag = None
        low = line.lower()
        if line.startswith("✅") or "complete" in low:
            tag = "ok"
        elif line.startswith("⚠️") or line.startswith("[!]"):
            tag = "warn"
        elif line.startswith("[✖]") or "failed" in low:
            tag = "err"
        elif line.startswith("🔄") or line.startswith("🔎"):
            tag = "info"
        self._append(line + "\n", tag)
        m = re.search(r"Step (\d)", line)
        if m:
            n = int(m.group(1))
            self.tracker.set_step(n, skipped=(n == 2 and "skipped" in low))
            if not (n == 2 and "skipped" in low):
                self.status_var.set(f"Step {StepTracker.MAP[n] + 1} of 6 · {self.STEP_TEXT[n]}")


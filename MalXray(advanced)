class MalXrayCLI(cmd.Cmd):
    prompt = "⚡ MalXray> "

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.intro = self._build_intro()
        self.confirmation_callback = None  # Desktop supplies a GUI confirm
        self.results = []  # structured results for the GUI verdict card

    # ------------------------------------------------------------------ status
    @staticmethod
    def _status_lines():
        has_static = os.path.exists(ml_classifier.PATHS.get("binary_static", ""))
        has_fused = os.path.exists(ml_classifier.PATHS.get("binary_fused", ""))
        if has_static and has_fused:
            ml = "ready (fused + static-only)"
        elif has_static or has_fused:
            ml = "partial (one model missing — run train_model.py)"
        else:
            ml = "NOT TRAINED (run generate_training_data.py → train_model.py)"
        vt = "key set" if getattr(virustotal_check, "API_KEY", None) else "no key (set VIRUSTOTAL_API_KEY)"
        vm = (
            "enabled"
            if os.environ.get("MALXRAY_ISOLATED_VM") == "1"
            else "disabled (required only for --detonate)"
        )
        return [
            f"ML models      : {ml}",
            f"VirusTotal     : {vt}",
            f"Detonation     : {vm}",
        ]

    def _build_intro(self):
        status = "\n    ".join(self._status_lines())
        return f"""
    ╔══════════════════════════════════════════════════╗
      🔥  MalXray — Hybrid Malware Scanner (MSc)  🔥
    ╚══════════════════════════════════════════════════╝

    {status}

    Commands:
      analyze <path> [--detonate] [--upload-vt]
      history | status | clear | exit
    """

    # ---------------------------------------------------------------- pipeline
    def locate_file(self, file_name):
        print("🔄  Step 0 · Locating file…")
        expanded = os.path.abspath(os.path.expanduser(os.path.normpath(file_name)))
        found = expanded if os.path.isfile(expanded) else None

        if not found:
            target = os.path.basename(file_name)
            for root, _, files in os.walk(os.getcwd()):
                if target in files:
                    found = os.path.join(root, target)
                    break

        if not found:
            print(f"[✖] File not found: {file_name}")
            logging.error(f"File not found: {file_name}")
            return None

        if os.name == "nt" and len(found) > 240 and not found.startswith("\\\\?\\"):
            found = "\\\\?\\" + found
        print(f"✅  Found: {found}")
        return found

    def run_pipeline(self, file_path, detonate=False, upload_vt=False):
        self.results = []
        try:
            located = self.locate_file(file_path)
            if not located:
                return
            if os.path.getsize(located) > MAX_ANALYSIS_BYTES:
                print(
                    f"[✖] File exceeds {MAX_ANALYSIS_BYTES // (1024 * 1024)} MB limit."
                )
                return

            work_dir = tempfile.mkdtemp(prefix="malxray_")
            try:
                print("🔄  Step 1 · Reading file & computing hashes…")
                file_data, file_info = extract_file_info(located, output_dir=work_dir)
                if file_data is None:
                    print("[✖] Could not read file.")
                    return

                container = os.path.basename(located)
                members = self._archive_members(file_info)

                if members:
                    print(
                        f"📦  Archive detected — analysing "
                        f"{min(len(members), MAX_ARCHIVE_MEMBERS)} of {len(members)} members"
                    )
                    for name, info in members[:MAX_ARCHIVE_MEMBERS]:
                        print(f"\n── {container} → {name} ──")
                        with open(info["File Path"], "rb") as f:
                            data = f.read()
                        self._analyze_one(
                            f"{container}__{name}",
                            info["File Path"],
                            data,
                            info,
                            detonate,
                            upload_vt,
                        )
                else:
                    if self._is_archive(file_info, located):
                        print(
                            "⚠️  Looks like an archive that could not be extracted "
                            "(password / unsupported). Verdict applies only to the container."
                        )
                    self._analyze_one(
                        container, located, file_data, file_info, detonate, upload_vt
                    )
            finally:
                shutil.rmtree(work_dir, ignore_errors=True)

        except Exception as e:
            logging.exception("Pipeline failed")
            print(f"[✖] Pipeline failed: {e}")

    @staticmethod
    def _archive_members(file_info):
        extracted = file_info.get("Extracted Contents") or {}
        return [
            (name, info)
            for name, info in extracted.items()
            if "Error" not in info and "File Path" in info
        ]

    @staticmethod
    def _is_archive(file_info, path):
        return (
            file_info.get("File Type") in ARCHIVE_MIMES
            or path.lower().endswith(ARCHIVE_EXTS)
        )

    def _analyze_one(self, label, path, data, info, detonate, upload_vt):
        behavior_data = None
        if detonate:
            behavior_data = self._detonate(path)
        else:
            print(
                "🔄  Step 2 · Runtime analysis skipped (static only). "
                "Use --detonate inside an isolated VM to enable it."
            )

        print("🔄  Step 3 · Fusing static + dynamic features…")
        fused = feature_fusion.fuse_features(
            path, file_data=data, behavior_data=behavior_data
        )

        print("🔄  Step 4 · ML classification (XGBoost)…")
        ml_result = ml_classifier.classify(fused)

        print("🔄  Step 5 · VirusTotal cross-check…")
        vt_results = self.virustotal_analysis(
            info.get("SHA-256"), path, upload_vt
        )

        verdict, message = self.risk_assessment(ml_result, vt_results)
        self.generate_final_report(
            label, info, behavior_data, ml_result, vt_results, verdict, message
        )

    # -------------------------------------------------------- detonation
    def _detonate(self, sample_path):
        print("🔄  Step 2 · Runtime analysis (DETONATION)…")
        if os.environ.get("MALXRAY_ISOLATED_VM") != "1":
            print(
                "[✖] Refusing to execute. Set MALXRAY_ISOLATED_VM=1 inside a "
                "disposable, network-isolated VM first."
            )
            return None

        warning = (
            "You are about to EXECUTE this file on this machine.\n\n"
            "Only continue inside a disposable, network-isolated VM with no "
            "personal data. Revert the VM snapshot afterwards.\n\n"
            "Type DETONATE to continue."
        )
        if self.confirmation_callback is not None:
            confirmed = bool(self.confirmation_callback(warning))
        else:
            print("\n  !!  " + warning.replace("\n\n", "\n  !!  ") + "\n")
            confirmed = (
                input("  Type DETONATE to run it now (anything else cancels): ").strip()
                == "DETONATE"
            )

        if not confirmed:
            print("Cancelled — continuing with static analysis only.")
            return None

        sandbox = behavior_monitor.SandboxEnvironment()
        try:
            staged = os.path.join(sandbox.temp_dir, os.path.basename(sample_path))
            shutil.copy2(sample_path, staged)
            os.chmod(staged, 0o755)
            result = sandbox.execute_and_monitor(
                staged, timeout=DETONATION_SECONDS, auto_execute=True
            )
        finally:
            sandbox.clean_up()

        if "Error" in result:
            print(f"[✖] Runtime analysis failed: {result['Error']}")
            return None

        s = result["Summary"]
        print(
            f"✅  Observed {s['num_new_processes']} new process(es), "
            f"{s['num_new_connections']} connection(s), "
            f"{s['num_dropped_files']} dropped file(s)."
        )
        print(
            "⚠️  Revert your VM snapshot now — the sample and anything it "
            "started may still be running or persisted."
        )
        return result

    # --------------------------------------------------- VirusTotal / risk
    def virustotal_analysis(self, file_hash, file_path, upload_vt=False):
        try:
            vt = virustotal_check.check_virustotal(file_hash)
            if "Error" in vt and "not found" in vt["Error"].lower():
                if upload_vt:
                    print("⚡  Hash unknown — uploading to VirusTotal…")
                    resp = virustotal_check.upload_file_for_scan(file_path)
                    vt = (
                        {"Error": resp["Error"]}
                        if "Error" in resp
                        else {
                            "Error": "Submitted for scanning. Re-run later for results."
                        }
                    )
                else:
                    vt = {
                        "Error": "Hash not found. File was NOT uploaded "
                        "(use --upload-vt to share it with VirusTotal)."
                    }
            print(
                "✅  VirusTotal complete."
                if "Error" not in vt
                else f"ℹ️  VirusTotal: {vt['Error']}"
            )
            return vt
        except Exception as e:
            logging.error(f"VirusTotal check failed: {e}")
            print(f"[✖] VirusTotal error: {e}")
            return {"Error": str(e)}

    def risk_assessment(self, ml_result, vt_results):
        print("🔄  Step 6 · Risk assessment…")
        vt_ok = isinstance(vt_results, dict) and "Error" not in vt_results
        vt_pos = vt_results.get("Malicious Detections", 0) if vt_ok else 0
        vt_family = vt_results.get("Malware Family", "Unknown") if vt_ok else "Unknown"

        if not ml_result.get("ml_available"):
            if vt_pos >= 1:
                return (
                    "Malicious",
                    f"ML unavailable; VirusTotal flagged by {vt_pos} engines "
                    f"(label: {vt_family}).",
                )
            return (
                "Unknown",
                "ML model unavailable and no VirusTotal result.",
            )

        p_mal = ml_result.get("malicious_confidence", 0.0)
        basis = "static + runtime" if ml_result.get("mode") == "fused" else "static-only"

        if ml_result["verdict"] == "Malicious":
            family = ml_result.get("predicted_family")
            msg = f"Malicious per model ({p_mal:.1%}, {basis})."
            if family:
                msg += (
                    f" Estimated family: {family} "
                    f"({ml_result.get('family_confidence', 0):.1%})."
                )
            if vt_pos > 0:
                msg += f" VirusTotal agrees ({vt_pos} engines, {vt_family})."
            elif vt_ok:
                msg += " VirusTotal did not flag it — treat disagreement carefully."
            return "Malicious", msg

        # Model says benign
        if vt_pos >= VT_ESCALATION_THRESHOLD:
            return (
                "Potentially Harmful",
                f"Model says benign ({1 - p_mal:.1%}, {basis}) but "
                f"{vt_pos} VirusTotal engines flag it ({vt_family}). "
                "Treat as suspicious until reviewed.",
            )
        msg = f"Benign per model ({1 - p_mal:.1%}, {basis})."
        if ml_result.get("reliability") == "low":
            msg += (
                " Low reliability: not a Windows PE — do not treat as clean."
            )
        return "Benign", msg

    # ------------------------------------------------------------ report
    def generate_final_report(
        self, label, file_info, behavior_data, ml_result, vt_data, verdict, message
    ):
        print("🔄  Step 7 · Generating PDF report…")
        try:
            os.makedirs("reports", exist_ok=True)
            report_path = os.path.join("reports", f"{_safe_name(label)}.pdf")
            report_generator.generate_report(
                file_info,
                behavior_data,
                vt_data,
                ml_result,
                verdict,
                report_path,
                highlights={"Verdict": message},
            )
            self.results.append(
                {
                    "label": label,
                    "verdict": verdict,
                    "message": message,
                    "p_mal": ml_result.get("malicious_confidence", 0.0),
                    "ml_available": bool(ml_result.get("ml_available")),
                    "family": ml_result.get("predicted_family"),
                    "mode": ml_result.get("mode"),
                    "sha256": file_info.get("SHA-256"),
                    "size": file_info.get("Size (bytes)"),
                    "vt_hits": (vt_data or {}).get("Malicious Detections")
                    if isinstance(vt_data, dict) and "Error" not in vt_data
                    else None,
                    "report": os.path.abspath(report_path),
                    "warnings": list(ml_result.get("warnings", [])),
                }
            )
            print(f"\n{VERDICT_ICONS.get(verdict, '')}  Verdict: {verdict}")
            print(f"   {message}")
            for w in ml_result.get("warnings", []):
                print(f"   ⚠️  {w}")
            print(f"📄  Report saved: {report_path}")
        except Exception as e:
            logging.exception("Report generation failed")
            print(f"[✖] Report error: {e}")

    # ---------------------------------------------------------- commands
    def do_analyze(self, arg):
        """analyze <file_path> [--detonate] [--upload-vt]"""
        try:
            tokens = [t.strip('"').strip("'") for t in shlex.split(arg, posix=False)]
        except ValueError as e:
            print(f"Could not parse arguments: {e}")
            return
        flags = [t for t in tokens if t.startswith("--")]
        path = " ".join(t for t in tokens if not t.startswith("--")).strip()

        bad = [f for f in flags if f not in VALID_FLAGS]
        if bad:
            print(f"Unknown option(s): {' '.join(bad)}")
            return
        if not path:
            print("Usage: analyze <file_path> [--detonate] [--upload-vt]")
            return

        print("🔎  Starting MalXray analysis pipeline…")
        self.run_pipeline(
            path,
            detonate="--detonate" in flags,
            upload_vt="--upload-vt" in flags,
        )

    def do_history(self, arg):
        if not os.path.isdir("reports"):
            print("⚠️  No reports yet.")
            return
        reports = sorted(
            (f for f in os.listdir("reports") if f.endswith(".pdf")),
            key=lambda f: os.path.getmtime(os.path.join("reports", f)),
            reverse=True,
        )
        print("\n📂  Previous reports:\n" + "\n".join(reports) if reports else "None.")

    def do_status(self, arg):
        print("\n".join(self._status_lines()))

    def do_clear(self, arg):
        os.system("cls" if os.name == "nt" else "clear")

    def do_exit(self, arg):
        print("👋  Exiting MalXray. Stay secure.")
        return True

    def emptyline(self):
        return None  # do not repeat last command

    def default(self, line):
        print(
            f"*** Unknown command: {line.split()[0] if line.split() else line}. "
            "Try: analyze, history, status, clear, exit"
        )





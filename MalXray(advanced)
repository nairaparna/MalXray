def _make_icon(path):
    """Draw the MalXray reticle logo as a multi-size .ico (needs Pillow)."""
    try:
        from PIL import Image, ImageDraw
    except Exception:
        return None
    s = 256
    img = Image.new("RGBA", (s, s), (0, 0, 0, 0))
    d = ImageDraw.Draw(img)
    d.rounded_rectangle((8, 8, s - 8, s - 8), radius=60, fill=COLORS["accent2"])
    d.ellipse((64, 64, 192, 192), outline="white", width=12)
    for box in ((122, 24, 134, 84), (122, 172, 134, 232), (24, 122, 84, 134), (172, 122, 232, 134)):
        d.rectangle(box, fill="white")
    d.ellipse((108, 108, 148, 148), fill=COLORS["accent"])
    img.save(path, format="ICO", sizes=[(16, 16), (32, 32), (48, 48), (64, 64), (128, 128), (256, 256)])
    return path


def _run(cmd_list, cwd):
    print("   $ " + " ".join(f'"{c}"' if " " in c else c for c in cmd_list))
    subprocess.check_call(cmd_list, cwd=cwd)


def _find_iscc():
    found = shutil.which("iscc") or shutil.which("ISCC")
    if found:
        return found
    for base in (os.environ.get("ProgramFiles(x86)"), os.environ.get("ProgramFiles"),
                 os.path.join(os.environ.get("LOCALAPPDATA", ""), "Programs")):
        if base:
            cand = os.path.join(base, "Inno Setup 6", "ISCC.exe")
            if os.path.isfile(cand):
                return cand
    return None


def build_installer():
    if FROZEN:
        print("Already an installed build — run --build from the source folder.")
        return 1
    root = SOURCE_DIR
    build_dir = os.path.join(root, "build")
    dist_dir = os.path.join(root, "dist")
    out_dir = os.path.join(root, "installer")
    py = sys.executable
    print(f"\n=== {APP_NAME} {APP_VERSION} · building installable software ===\n")

    print("[1/5] Installing build tools…")
    req = os.path.join(root, "requirements.txt")
    if os.path.isfile(req):
        _run([py, "-m", "pip", "install", "--quiet", "-r", req], root)
    _run([py, "-m", "pip", "install", "--quiet", "pyinstaller", "pillow"], root)

    print("[2/5] Checking ML models…")
    model_dir = os.environ["MALXRAY_MODEL_DIR"]
    need = [ml_classifier.PATHS["binary_static"], ml_classifier.PATHS["binary_fused"]]
    if not all(os.path.exists(p) for p in need):
        print("   Models missing — generating training data and training (a few minutes)…")
        _run([py, "generate_training_data.py"], root)
        _run([py, "train_model.py"], root)
    if not os.path.isdir(model_dir) or not os.listdir(model_dir):
        print("[✖] Models folder is still empty — fix training first.")
        return 1
    print(f"   Models OK ({len(os.listdir(model_dir))} files)")

    print("[3/5] Creating app icon…")
    os.makedirs(build_dir, exist_ok=True)
    icon = _make_icon(os.path.join(build_dir, "MalXray.ico"))

    print("[4/5] Packaging the application (PyInstaller)…")
    cmd_list = [
        py, "-m", "PyInstaller", "--noconfirm", "--clean", "--windowed",
        "--name", APP_NAME, "--distpath", dist_dir, "--workpath", build_dir,
        "--specpath", build_dir, "--paths", root,
        "--add-data", f"{model_dir}{os.pathsep}models",
        "--collect-all", "xgboost", "--collect-all", "sklearn",
        "--collect-data", "reportlab",
        "--hidden-import", "joblib", "--hidden-import", "psutil",
    ]
    if HAS_DND:
        cmd_list += ["--collect-all", "tkinterdnd2"]
    else:
        print("   (tkinterdnd2 not installed — drag-and-drop will be click-to-browse only)")
    if icon:
        cmd_list += ["--icon", icon]
    cmd_list.append(os.path.abspath(__file__))
    _run(cmd_list, root)
    app_dir = os.path.join(dist_dir, APP_NAME)

    print("[5/5] Creating the installer…")
    os.makedirs(out_dir, exist_ok=True)
    iscc = _find_iscc() if os.name == "nt" else None
    if iscc:
        iss = INNO_TEMPLATE
        for k, v in {
            "@NAME@": APP_NAME, "@VERSION@": APP_VERSION, "@OUTDIR@": out_dir,
            "@DIST@": app_dir,
            "@ICONLINE@": f"SetupIconFile={icon}\n" if icon else "",
        }.items():
            iss = iss.replace(k, v)
        iss_path = os.path.join(build_dir, "MalXray.iss")
        with open(iss_path, "w", encoding="utf-8") as f:
            f.write(iss)
        _run([iscc, iss_path], root)
        print(f"\n✅  Done!  Installer: {os.path.join(out_dir, 'MalXray_Setup.exe')}")
        print("    Double-click it to install MalXray, then launch it from the Start menu.")
        return 0

    zip_base = os.path.join(out_dir, "MalXray_Portable")
    shutil.make_archive(zip_base, "zip", dist_dir, APP_NAME)
    print(f"\n✅  App built: {app_dir}")
    print(f"    Portable zip: {zip_base}.zip  (unzip anywhere, run {APP_NAME}.exe)")
    if os.name == "nt":
        print("    For a proper Setup wizard, install Inno Setup 6 (https://jrsoftware.org/isdl.php)")
        print("    and run:  python MalXray.py --build   again.")
    else:
        print("    Setup.exe can only be built on Windows — run --build there.")
    return 0



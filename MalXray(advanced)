    def _confirm_detonation(self, warning):
        result = {"confirmed": False}
        event = threading.Event()

        def ask():
            result["confirmed"] = messagebox.askyesno(
                "MalXray — Confirm sandbox run",
                warning + "\n\nClick Yes only if this machine is the disposable, "
                "network-isolated VM described above.",
                icon="warning",
            )
            event.set()

        self.after(0, ask)
        event.wait()
        return result["confirmed"]

    def _start_analysis(self):
        if self.analysis_running:
            return
        path = self.selected
        if not path:
            messagebox.showwarning("MalXray", "Choose a file first (drop it on the box or click it).")
            return
        if not os.path.isfile(path):
            messagebox.showerror("MalXray", "That file no longer exists.")
            return

        if self.detonate_var.get() and os.environ.get("MALXRAY_ISOLATED_VM") != "1":
            messagebox.showwarning(
                "Sandbox run blocked",
                "The sandbox option is on, but MALXRAY_ISOLATED_VM=1 is not set.\n\n"
                "The file will NOT be executed. To enable it, run MalXray inside a "
                "disposable, network-isolated VM and set that environment variable there.",
            )
            self.detonate_var.set(False)

        self.analysis_running = True
        self.scan_btn.set_enabled(False)
        self.tracker.reset()
        self.tracker.set_step(1)
        self.status_var.set(f"Step 1 of 6 · {self.STEP_TEXT[1]}")
        self._show_placeholder("Scanning…")
        self._append("\n" + "─" * 60 + "\n🔎  Starting analysis…\n", "info")

        detonate, upload = self.detonate_var.get(), self.upload_vt_var.get()

        def worker():
            writer = _QueueWriter(self.output_queue)
            old_out, old_err = sys.stdout, sys.stderr
            sys.stdout = sys.stderr = writer
            try:
                self.backend.run_pipeline(path, detonate=detonate, upload_vt=upload)
            except Exception as exc:
                logging.exception("Desktop analysis failed")
                print(f"[✖] Desktop analysis failed: {exc}")
            finally:
                sys.stdout, sys.stderr = old_out, old_err
                self.after(0, self._analysis_finished)

        threading.Thread(target=worker, daemon=True).start()

    def _analysis_finished(self):
        self.analysis_running = False
        self.scan_btn.set_enabled(True)
        self._drain_output_now()
        results = self.backend.results
        if results:
            self.tracker.finish(True)
            self.status_var.set("Scan complete.")
            self._show_result(results)
        else:
            self.tracker.finish(False)
            self.status_var.set("Scan could not finish — open the technical log for details.")
            self._show_placeholder("The scan did not produce a result. See the technical log.")
        self._refresh_status()

    def _drain_output_now(self):
        try:
            while True:
                self._buf += self.output_queue.get_nowait()
        except queue.Empty:
            pass
        if self._buf:
            self._buf += "\n"
        while "\n" in self._buf:
            line, self._buf = self._buf.split("\n", 1)
            self._handle_line(line)

    def _on_close(self):
        if self.analysis_running and not messagebox.askyesno(
            "Exit MalXray", "A scan is still running. Exit anyway?"
        ):
            return
        self.destroy()


class _QueueWriter:
    def __init__(self, q):
        self.q = q

    def write(self, value):
        if value:
            self.q.put(value)

    def flush(self):
        pass



def main():
    if "--build" in sys.argv and not FROZEN:
        try:
            sys.exit(build_installer())
        except subprocess.CalledProcessError as e:
            print(f"[✖] Build step failed: {e}")
            sys.exit(1)

    if "--cli" in sys.argv:
        try:
            MalXrayCLI().cmdloop()
        except KeyboardInterrupt:
            print("\n👋  Interrupted.")
        except Exception as e:
            logging.exception("CLI error")
            print(f"[✖] Unexpected error: {e}")
            input("Press Enter to exit…")
        return

    if sys.platform == "win32":
        try:  # crisp text on high-DPI screens
            import ctypes

            ctypes.windll.shcore.SetProcessDpiAwareness(1)
        except Exception:
            pass
    try:
        app = MalXrayDesktopApp()
        app.mainloop()
    except KeyboardInterrupt:
        print("\n👋  Interrupted.")
    except Exception as e:
        logging.exception("Desktop error")
        try:
            messagebox.showerror("MalXray Error", str(e))
        except Exception:
            print(f"[✖] Unexpected error: {e}")


if __name__ == "__main__":
    main()
